rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /users/{uid}/records/{recordId} {
   allow read: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasOnly(['type','id','data','deleted','mutation','updatedAt'])
    && request.resource.data.type in ['tasks','projects','events','filters','settings']
    && request.resource.data.id is string
    && request.resource.data.data is map
    && request.resource.data.deleted is bool
    && request.resource.data.mutation is string;
   allow delete: if false;
  }
  match /users/{uid}/subscriptions/{id} { allow read: if owner(uid); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
